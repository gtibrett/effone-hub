# ── effone-hub site (Next.js) ──
# Only vars actually read by the app. Copy to .env and fill in.

# Postgres connection for the in-process PostGraphile executor
# (src/app/lib/graphql-executor.ts). GraphQL executes inside the Next server —
# there is no standalone api deployment in production.
# Local dev: optional — falls back to the docker compose DB (packages/database):
#   postgres://postgres:effonehub@localhost:5432/postgres
# On Vercel: REQUIRED (Neon pooled URL) — the app throws at runtime if unset.
POSTGRES_URL=

# Comma-separated schemas PostGraphile introspects. Default: f1db,app
POSTGRES_SCHEMA=f1db,app

# Google Analytics measurement ID. Optional — omit to disable the GA script.
NEXT_PUBLIC_GA_TRACKING_ID=

# GraphQL codegen schema source (`pnpm codegen`). Optional — defaults to the
# committed SDL at ../api/schema.graphql; set to a live URL to codegen against a
# running API instead.
CODEGEN_SCHEMA_URL=

# Shared secret for POST /api/cron/revalidate, checked as `Authorization: Bearer <secret>`
# against the GitHub Actions ingest runner. The route fails closed (500) if unset, so
# any deployment serving it REQUIRES this. Must match the api ingest job's CRON_SECRET.
CRON_SECRET=

# ── Vercel platform-injected — do NOT set these manually ──
# VERCEL      auto-set to "1" on Vercel; gates the POSTGRES_URL requirement.
# VERCEL_ENV  "production" | "preview" | "development"; preview builds skip
#             prerendering entirely (src/app/lib/static-params.ts).
